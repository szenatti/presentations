{
    "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
    "description": "Actual expenditure by department.",
    "width": "container",
    "height": "container",
    "encoding": {
        "y": { "field": "DepartmentName", "type": "nominal", "sort": "-x", "title": null },
        "x": { "field": "ActualAmount", "type": "quantitative", "title": "Actual Amount" }
    },
    "layer": [
        { "mark": "bar" },
        {
            "mark": { "type": "text", "style": "labelHorizontal" },
            "encoding": { "text": { "field": "ActualAmount", "type": "quantitative" } }
        }
    ]
}
